# Copy this to .env and fill in your values
# Never commit .env to git

# PostgreSQL — local example: postgresql+asyncpg://postgres:password@localhost:5432/prognos
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prognos

# Redis — local default
REDIS_URL=redis://localhost:6379/0

# Google OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# CLIST — contest discovery (clist.by)
# Register at https://clist.by/api/v4/doc/ to get credentials
CLIST_USERNAME=
CLIST_API_KEY=

# App
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Test database -- pytest uses THIS, never DATABASE_URL.
# tests/conftest.py aborts collection if the resolved host is not local, so the
# suite can never write to production again. Create it with:
#   createdb prognos_test && DATABASE_URL=$TEST_DATABASE_URL alembic upgrade head
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prognos_test
